  "sources": {
    "suncalc": {
      "version": "1.9.0",
      "url": "https://github.com/mourner/suncalc/blob/v1.9.0/suncalc.js",
      "call": "getPosition(new Date(time), latitudeDeg, longitudeDeg)"
    },
    "astronomyEngine": {
      "version": "2.1.19",
      "url": "https://www.npmjs.com/package/astronomy-engine/v/2.1.19",
      "calls": [
        "Horizon(time, observer, Equator(body, time, observer, true, true).ra, Equator(body, time, observer, true, true).dec, \"normal\")",
        "MoonPhase(time)",
        "Illumination(Body.Moon, time).phase_fraction",
        "DefineStar(Body.Star1, raDeg / 15, decDeg, 1000), then Equator(Body.Star1, time, new Observer(0, 0, 0), true, true)",
        "SiderealTime(time) * 15"
      ]
    }
  },
